{
  "name": "@lcm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test dist/app/app.test.js dist/modules/inventory/inventory.test.js dist/modules/inventory/stock.test.js",
    "inventory:backfill-receipts": "npm run build && node dist/modules/inventory/cli.js backfill",
    "inventory:rebuild-balances": "npm run build && node dist/modules/inventory/cli.js rebuild",
    "inventory:verify": "npm run build && node dist/modules/inventory/cli.js verify",
    "test:dynamodb": "npm run build && node --test dist/modules/inventory/dynamodb.integration.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.883.0",
    "@aws-sdk/lib-dynamodb": "^3.883.0",
    "@fastify/cors": "^10.1.0",
    "@lcm/contracts": "0.1.0",
    "argon2": "^0.44.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "@types/jsonwebtoken": "^9.0.10",
    "tsx": "^4.20.5",
    "typescript": "~5.7.3"
  }
}
