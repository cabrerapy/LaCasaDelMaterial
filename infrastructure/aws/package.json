{
  "name": "@lcm/aws",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "synth": "npm run build && cdk synth --no-lookups",
    "prepare:runtime": "npm run build && node dist/bin/prepare-runtime-publication.js",
    "deploy": "node scripts/deploy-blocked.mjs"
  },
  "engines": {
    "node": ">=24.15 <25"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/client-sts": "3.1149.0",
    "aws-cdk-lib": "2.273.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "aws-cdk": "2.1145.0",
    "typescript": "6.0.2"
  }
}
