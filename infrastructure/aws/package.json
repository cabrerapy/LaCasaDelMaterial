{
  "name": "@lcm/aws",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare:execution-review": "npm run build && node dist/bin/prepare-execution-review.js",
    "prepare:executor-authority": "npm run build && node dist/bin/prepare-executor-authority.js",
    "prepare:publisher-delegation": "npm run build && node dist/bin/prepare-publisher-delegation.js",
    "prepare:asset-publisher": "npm run build && node dist/bin/prepare-asset-publisher.js",
    "prepare:asset-publication": "npm run build && node dist/bin/prepare-asset-publication.js",
    "prepare:asset-read": "npm run build && node dist/bin/prepare-asset-read.js",
    "prepare:executor-review": "npm run build && node dist/bin/prepare-executor-review.js",
    "prepare:edge-maintenance": "npm run build && node dist/bin/prepare-edge-maintenance.js",
    "prepare:edge-create": "npm run build && node dist/bin/prepare-edge-creation.js",
    "prepare:boundary": "npm run build && node dist/bin/prepare-runtime-boundary.js",
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "synth": "npm run build && cdk synth --no-lookups",
    "synth:review": "npm run build && cdk synth --no-lookups --app \"node dist/bin/review-app.js\" --output cdk.out-review",
    "prepare:runtime": "npm run build && node dist/bin/prepare-runtime-publication.js",
    "deploy": "node scripts/deploy-blocked.mjs"
  },
  "engines": {
    "node": ">=24.15 <25"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/client-sts": "3.1149.0",
    "aws-cdk-lib": "2.273.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "aws-cdk": "2.1145.0",
    "typescript": "6.0.2"
  }
}
