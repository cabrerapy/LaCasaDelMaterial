{
  "compilerOptions": {
    "target": "ES2023", "module": "Node16", "moduleResolution": "Node16",
    "strict": true, "types": ["node"], "outDir": "dist", "rootDir": ".", "skipLibCheck": true,
    "noUncheckedIndexedAccess": true, "forceConsistentCasingInFileNames": true
  },
  "include": ["bin/**/*.ts", "lib/**/*.ts", "test/**/*.ts"]
}
