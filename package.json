{
  "name": "la-casa-del-material",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @lcm/contracts && npm run build --workspace @lcm/api && npm run build --workspace @lcm/web",
    "lint": "npm run build --workspace @lcm/contracts && npm run lint --workspace @lcm/contracts && npm run lint --workspace @lcm/api && npm run lint --workspace @lcm/web",
    "test": "npm run test --workspace @lcm/contracts && npm run test --workspace @lcm/api && npm run test --workspace @lcm/web",
    "inventory:backfill-receipts": "npm run inventory:backfill-receipts --workspace @lcm/api",
    "inventory:rebuild-balances": "npm run inventory:rebuild-balances --workspace @lcm/api",
    "inventory:verify": "npm run inventory:verify --workspace @lcm/api",
    "costing:backfill": "npm run costing:backfill --workspace @lcm/api",
    "costing:rebuild-lot-balances": "npm run costing:rebuild-lot-balances --workspace @lcm/api",
    "costing:verify": "npm run costing:verify --workspace @lcm/api",
    "trip-loads:backfill": "npm run trip-loads:backfill --workspace @lcm/api",
    "trip-loads:rebuild-balances": "npm run trip-loads:rebuild-balances --workspace @lcm/api",
    "trip-loads:verify": "npm run trip-loads:verify --workspace @lcm/api",
    "dev:web": "npm run start --workspace @lcm/web",
    "dev:api": "npm run dev --workspace @lcm/api"
  },
  "engines": {
    "node": ">=24.15 <25"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "argon2@0.44.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
